# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file (it's already in .gitignore).

# development | test | production
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# MongoDB connection string (local mongod or a MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/no-distractions

# The client's origin, used for CORS + cookie settings. Must match exactly
# (protocol + host + port) — no trailing slash.
CLIENT_URL=http://localhost:5173

# REQUIRED. Secret used to sign/verify short-lived access tokens (JWT).
# Deliberately left empty: the server refuses to start until you set a real
# one (32+ characters). Generate it with:  openssl rand -hex 32
# Never reuse this value across environments, and never commit a real one.
JWT_ACCESS_SECRET=
